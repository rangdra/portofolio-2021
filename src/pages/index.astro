---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import AbstractLines from "../components/AbstractLines.astro";
import ProjectImage from "../components/ProjectImage.astro";
import Projects from "../components/Projects.astro";
import { services, projects as projectsData, frontendSkills, backendSkills } from "../data";
import { categoryLabel, projectCover } from "../projects";

const CV = "/assets/CV Rangdra Pangestu - Software Engineer.pdf";
const featured = projectsData.slice(0, 5);
const gradients = ["c-violet", "c-rose", "c-amber", "c-lime", "c-sky", "c-peach"];
// TypeScript sits in both skill lists.
const stack = Array.from(new Set([...frontendSkills, ...backendSkills].map((skill) => skill.name)));
const words = (text: string) => text.split(" ");

// structured data so search engines know this site is Rangdra Pangestu's
const SITE = Astro.site!.origin;
const currentUrl = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE}/#person`,
      name: "Rangdra Pangestu",
      alternateName: "Rangdra",
      url: `${SITE}/`,
      image: `${SITE}/me.webp`,
      jobTitle: "Software Engineer",
      worksFor: { "@type": "Organization", name: "PT. Vanz Inovatif Teknologi" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "STMIK Pranata Indonesia" },
      address: { "@type": "PostalAddress", addressLocality: "Bekasi", addressCountry: "ID" },
      email: "mailto:rangdra2@gmail.com",
      sameAs: [
        "https://github.com/rangdra",
        "https://www.linkedin.com/in/rangdra-pangestu-7b991219a/",
        "https://www.instagram.com/rngdr_",
      ],
      knowsAbout: ["TypeScript", "React", "Next.js", "React Native", "Node.js", "NestJS", "PostgreSQL", "MongoDB"],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: `${SITE}/`,
      name: "Rangdra Pangestu",
      publisher: { "@id": `${SITE}/#person` },
    },
  ],
};
---

<Base title="Rangdra Pangestu — Software Engineer">
  <Fragment slot="head">
    <meta
      name="description"
      content="Software Engineer specializing in TypeScript, React, Next.js, React Native, Node.js, NestJS, and PostgreSQL. View projects, experience, and contact info."
    />
    <meta property="og:title" content="Rangdra Pangestu — Software Engineer" />
    <meta
      property="og:description"
      content="Software Engineer crafting high-performance digital products."
    />
    <link rel="canonical" href={currentUrl} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rangdra Pangestu" />
    <meta property="og:image" content={`${SITE}/og-image.webp`} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rangdra Pangestu — Software Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Rangdra Pangestu — Software Engineer" />
    <meta name="twitter:image" content={`${SITE}/og-image.webp`} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div id="home">
    <!-- ─── HERO ─── -->
    <section class="hero" id="about">
      <h1 class="hero-title">
        <!-- the name sits in the h1 so search engines tie the page to it -->
        <span class="hero-name">Rangdra Pangestu · Software Engineer</span>
        <span class="line"><span class="sans">Building Scalable</span></span>
        <span class="line indent"><span class="serif">Digital Products</span></span>
      </h1>
      <div class="hero-pill">
        <Image
          src="/img/hero.webp"
          srcset="/img/hero-960.webp 960w, /img/hero-1600.webp 1600w, /img/hero.webp 2400w"
          sizes="(max-width: 820px) 120vw, 84vw"
          width={2400}
          height={1000}
          alt=""
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-bottom">
        <h2>
          <span class="line"><span class="sans">that Actually</span></span>
          <span class="line"><span class="serif">Matter.</span></span>
        </h2>
        <p class="hero-copy">
          Hi, I'm <strong>Rangdra Pangestu</strong> — a Software Engineer
          in Bekasi, Indonesia. <a href={CV} download>Download CV ↓</a>
        </p>
      </div>
    </section>

    <!-- ─── STATEMENT ─── -->
    <section class="statement">
      <AbstractLines variant="waves" />
      <p class="split">
        <span class="sans">{words("Great products don't need more code.").map((word) => <span class="word">{word}{" "}</span>)}</span>
        <span class="serif muted">{words("They need clean architecture").map((word) => <span class="word">{word}{" "}</span>)}</span>
        <span class="serif muted">{words("and thoughtful UX.").map((word) => <span class="word">{word}{" "}</span>)}</span>
      </p>
      <ul class="problems">
        {services.map((s) => <li>{s.title}</li>)}
      </ul>
    </section>

    <!-- ─── STRIP: everyday developer artifacts ─── -->
    <section class="strip" aria-hidden="true">
      <div class="strip-row">
        <div class="art dark">
          <span class="art-bar">zsh</span>
          <pre>{`$ yarn build
✓ Compiled successfully
✓ Static pages (5/5)
$ _`}</pre>
        </div>
        <div class="art">
          <span class="art-bar">developer.ts</span>
          <pre>{`const engineer = {
  name: "Rangdra",
  role: "Software Engineer",
  stack: ["React",
    "NestJS", "RN"],
};`}</pre>
        </div>
        <div class="art dark">
          <span class="art-bar"><b class="get-verb">GET</b> /api/projects</span>
          <pre>{`200 OK
[{
  "name": "RE/MAX",
  "category": [
    "WEB", "CMS",
    "MOBILE", "API"]
}]`}</pre>
        </div>
        <div class="art phone">
          <i class="ph-notch" />
          <i class="ph-hero" />
          <i class="ph-line" /><i class="ph-line short" />
          <div class="ph-grid"><i /><i /><i /><i /></div>
          <i class="ph-btn" />
        </div>
        <div class="art dark">
          <span class="art-bar">git log --oneline</span>
          <pre>{`● feat: booking flow
● fix: empty state
● refactor: api client
● chore: bump deps`}</pre>
        </div>
        <div class="art">
          <span class="art-bar">query.sql</span>
          <pre>{`SELECT name
FROM projects
WHERE 'APP'
  = ANY(category);`}</pre>
        </div>
        <div class="art dark ci">
          <span class="art-bar">pipeline</span>
          <pre>{`✓ lint
✓ test
✓ build
✓ deploy`}</pre>
        </div>
      </div>
    </section>

    <!-- ─── SERVICES (collage of what each service looks like) ─── -->
    <section class="process" id="services">
      <figure class="float f1" data-speed="-0.25">
        <div class="browser">
          <span class="browser-bar"><i /><i /><i /><em>yourproduct.app</em></span>
          <Image src="/img/ui-frontend.webp" alt="Landing page interface illustration" width={640} height={400} loading="lazy" decoding="async" />
        </div>
        <figcaption>Frontend</figcaption>
      </figure>
      <figure class="float f2" data-speed="0.2">
        <div class="art dark">
          <span class="art-bar">properties.controller.ts</span>
          <pre>{`@Controller('properties')
export class PropertiesController {
  @Get()
  findAll() {
    return this.service.findAll();
  }
}`}</pre>
        </div>
        <figcaption>Backend</figcaption>
      </figure>
      <figure class="float f3" data-speed="-0.1">
        <div class="device">
          <Image src="/img/ui-mobile.webp" alt="Mobile app interface illustration" width={360} height={720} loading="lazy" decoding="async" />
        </div>
        <figcaption>Mobile</figcaption>
      </figure>
      <figure class="float f4" data-speed="0.3">
        <div class="art">
          <span class="art-bar"><b class="get-verb">POST</b> /v1/consultations</span>
          <pre>{`201 Created
{
  "id": 1042,
  "status": "booked"
}`}</pre>
        </div>
        <figcaption>API</figcaption>
      </figure>
      <figure class="float f5" data-speed="-0.3">
        <div class="browser">
          <span class="browser-bar"><i /><i /><i /><em>admin / dashboard</em></span>
          <Image src="/img/ui-cms.webp" alt="Admin dashboard interface illustration" width={640} height={400} loading="lazy" decoding="async" />
        </div>
        <figcaption>CMS</figcaption>
      </figure>
      <svg class="connectors" aria-hidden="true">
        {[0, 1, 2, 3, 4].map(() => <path />)}
        {[0, 1, 2, 3, 4].map(() => <circle r="4" />)}
      </svg>
      <div class="process-center">
        <div class="doc" aria-hidden="true"><i /><i /><i /><i /><i /><i /><span class="tag">Spec</span></div>
        <p class="process-text">
          <span class="sans">I build end-to-end, from pixel-perfect interfaces</span>{" "}
          <span class="serif">— to robust APIs and mobile apps.</span>
        </p>
        <div class="get">
          <strong>You get:</strong>
          <span>React &amp; Next.js web apps</span>
          <span>React Native mobile apps</span>
          <span>NestJS &amp; Express APIs</span>
          <span>PostgreSQL &amp; MongoDB data</span>
        </div>
      </div>
    </section>

    <!-- ─── FOCUS: three working principles ─── -->
    <section class="finds">
      <AbstractLines variant="contour" />
      <div class="finds-head">
        <svg class="burst" viewBox="0 0 100 100" aria-hidden="true">
          <rect width="100" height="100" rx="24" fill="#111" />
          <g fill="#fff" transform="translate(50 54)">
            {[-90, -60, -30, 0, 30, 60, 90].map((r) => (
              <path d="M-3 0 L-1 -34 L1 -34 L3 0Z" transform={`rotate(${r})`} />
            ))}
            <circle r="9" fill="#111" />
          </g>
        </svg>
        <span class="chip">Focus</span>
        <h2 class="finds-title"><span class="sans">What I</span> <span class="serif">care about</span></h2>
      </div>
      <ol class="principles">
        <li>
          <span class="num">01</span>
          <h3><span class="sans">Performance</span></h3>
          <p>Fast loads and smooth interactions, on the web and on mobile.</p>
          <code>next build · lazy images · lean bundles</code>
        </li>
        <li>
          <span class="num">02</span>
          <h3><span class="serif">Clean UX</span></h3>
          <p>Working closely with UI/UX designers and QA to ship flows that feel right.</p>
          <code>design → build → QA → ship</code>
        </li>
        <li>
          <span class="num">03</span>
          <h3><span class="sans">Maintainable code</span></h3>
          <p>Modular, reusable code following clean architecture, so the next feature is easy.</p>
          <code>modules · services · typed APIs</code>
        </li>
      </ol>
    </section>

    <!-- ─── WORK (pinned stage) ─── -->
    <section class="work" id="work">
      <div class="work-stage">
        <div class="work-bg">
          <div class="sky" />
          <Image class="hills" src="/img/work-bg.webp" alt="" width={1920} height={1200} loading="lazy" decoding="async" />
        </div>
        <div class="work-column">
          <div class="title-card">
            <span class="chip dark">Selected work</span>
            <p><span class="sans">Shipped for</span><br /><span class="serif">real clients:</span></p>
          </div>
          {featured.map((p, i) => (
            <button type="button" class={`pcard ${gradients[i]}`} data-project={p.id} aria-haspopup="dialog">
              <h3>{p.name} <em>{p.category.map(categoryLabel).join(" · ").toLowerCase()}</em></h3>
              <ProjectImage src={projectCover(p.image_path, 768)} alt={`${p.name} project`} />
            </button>
          ))}
        </div>
      </div>
    </section>

    <Projects />

    <!-- ─── SKILLS ─── -->
    <section class="bring" id="skills">
      <div class="blob" aria-hidden="true" />
      <h2 class="bring-title"><span class="sans">My</span> <span class="serif">Stack</span></h2>
      <ul class="tags">
        {stack.map((s) => <li>{s}</li>)}
      </ul>
      <svg class="sticker smiley" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="#F4E04D" stroke="#111" stroke-width="3" /><ellipse cx="24" cy="25" rx="3" ry="5" fill="#111" /><ellipse cx="40" cy="25" rx="3" ry="5" fill="#111" /><path d="M19 37 Q32 52 45 37" fill="none" stroke="#111" stroke-width="3" stroke-linecap="round" /></svg>
      <svg class="sticker eyes" viewBox="0 0 80 60" aria-hidden="true"><ellipse cx="24" cy="28" rx="16" ry="20" fill="#fff" stroke="#111" stroke-width="3" /><ellipse cx="56" cy="28" rx="16" ry="20" fill="#fff" stroke="#111" stroke-width="3" /><circle cx="28" cy="32" r="7" fill="#111" /><circle cx="60" cy="32" r="7" fill="#111" /><path d="M30 54 Q40 60 50 54" fill="none" stroke="#111" stroke-width="3" stroke-linecap="round" /></svg>
      <svg class="sticker star" viewBox="0 0 70 70" aria-hidden="true"><path d="M35 4 L43 26 L66 27 L48 41 L54 64 L35 51 L16 64 L22 41 L4 27 L27 26Z" fill="#B9F27C" stroke="#111" stroke-width="3" stroke-linejoin="round" /></svg>
      <span class="sticker cool" aria-hidden="true">CODE</span>
    </section>

    <!-- ─── EXPERIENCE (pinned stage) ─── -->
    <section class="manifesto" id="experience">
      <div class="mani-stage">
        <div class="mani-bg">
          <Image class="exp-light" src="/img/exp-bg.webp" alt="" width={1920} height={1200} loading="lazy" decoding="async" />
          <!-- dark theme reuses the work section's aurora -->
          <Image class="exp-dark" src="/img/work-bg.webp" alt="" width={1920} height={1200} loading="lazy" decoding="async" />
        </div>
        <div class="mani-cards">
          <div class="not-card exp-card">
            <span class="chip dark">Experience · Dec 2022 – Present</span>
            <p class="exp-role"><span class="sans">Associate Developer</span><br /><span class="serif">PT. Vanz Inovatif Teknologi</span></p>
            <p class="not">Multiplatform apps (mobile, CMS, web) with React Native, React &amp; Next.js.</p>
            <p class="not">RESTful backend APIs with NestJS &amp; PostgreSQL.</p>
            <p class="not">Shipping defect-free flows with UI/UX designers &amp; QA.</p>
            <p class="not">Modular, reusable code following clean architecture.</p>
          </div>
          <div class="is-card">
            <p><span class="sans">Bachelor of Computer</span><br /><span class="serif">Information System</span></p>
            <div class="is-imgs">
              {projectsData.slice(0, 3).map((p) => <ProjectImage src={projectCover(p.image_path, 192)} alt="" />)}
            </div>
            <small>STMIK Pranata Indonesia · 2019 – 2023 · GPA 3.58 / 4.00</small>
            <small>Jabar Coding Camp (React.js) · 15+ completed projects</small>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  function watchScroll() {
    const root = document.querySelector<HTMLElement>("#home")!;
    const loadMotion = () => {
      void import("../scripts/scroll-motion").then(({ initHomeMotion }) => initHomeMotion(root));
    };

    if (window.scrollY > 0 || window.location.hash) loadMotion();
    else window.addEventListener("scroll", loadMotion, { once: true, passive: true });
  }

  if (document.readyState === "complete") watchScroll();
  else window.addEventListener("load", watchScroll, { once: true });
</script>
